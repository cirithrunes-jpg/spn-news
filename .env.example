# Replace with the final canonical HTTPS domain on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set true when ready to allow search-engine indexing.
SITE_INDEXABLE=false

# Public editorial contact address. Used by mailto links; never place credentials here.
EDITORIAL_CONTACT_EMAIL=

# Editorial login. A publishable key is public; NEVER use a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Private server-only automation credentials. Never use NEXT_PUBLIC_ for these.
SUPABASE_SECRET_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Use the supported version shown in the Meta app dashboard (e.g. v25.0).
INSTAGRAM_API_VERSION=
# Random secret, at least 32 characters, configured privately in Vercel.
CRON_SECRET=

